{
  "name": "rifas-api",
  "version": "1.0.0",
  "description": "API para gerenciamento de rifas",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "pnpm db:up && pnpm db:wait && tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:up": "docker-compose up -d postgres",
    "db:wait": "tsx scripts/wait-for-db.ts",
    "db:down": "docker-compose down",
    "typeorm": "tsx node_modules/typeorm/cli.js",
    "migration:create": "tsx scripts/migration-create.ts",
    "migration:run": "pnpm run typeorm migration:run -d src/config/data-source.ts",
    "migration:revert": "pnpm run typeorm migration:revert -d src/config/data-source.ts",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\""
  },
  "keywords": [],
  "author": "Leonardo Feitosa",
  "license": "ISC",
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.0.0",
    "zod": "^4.4.3"
  }
}
